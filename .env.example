# Copy to .env and adjust. Every line is optional: without a .env the vault
# lands in ./data and the container runs as whoever owns that directory.

# Where the vault directory lives on this machine. It holds bookmarks.db.
BOOKMARKS_VAULT_DIR=./data

# The user the api runs as, so it can read and write the vault directory.
# Leave both out and it takes the uid that owns that directory, which is what
# you want on any machine. Set them (`id -u`, `id -g`) only to override it.
# BOOKMARKS_UID=1000
# BOOKMARKS_GID=1000

# Host port the app is published on.
BOOKMARKS_WEB_PORT=8080

# Origins allowed to call the API from a browser, comma separated. Empty is
# correct for the stack as shipped: the PWA is same-origin behind nginx.
BOOKMARKS_ALLOWED_ORIGINS=

# The test account created on every boot. BOOKMARKS_SEED=0 turns it off.
BOOKMARKS_SEED_PASSWORD=teste123
