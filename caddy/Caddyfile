# TLS na frente do Vaultmarks.
#
# Por que isso existe: no celular a PWA so instala (e o service worker so
# registra) em "secure context" — https ou localhost. Acessar
# http://192.168.0.x:8787 do celular nao serve. O Caddy emite um certificado
# com uma CA propria e resolve isso sem depender de dominio publico.
#
# Passo unico: instalar a CA raiz no celular. Ela fica em
# http://<SITE>/root.crt (ver o bloco http:// abaixo).

{
	# Emite tudo com a CA interna em vez do Let's Encrypt — nao ha dominio
	# publico nem porta 80 aberta pra fora numa rede local.
	local_certs
	admin off
}

# VAULTMARKS_SITE = como voce acessa: hostname, ou o IP da maquina na LAN.
{$VAULTMARKS_SITE:vaultmarks.local} {
	tls internal

	encode zstd gzip

	header {
		# Sem isso o navegador pode adivinhar o tipo do manifest e ignora-lo.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	reverse_proxy vaultmarks:8787
}

# HTTP fica so para entregar a CA raiz — antes de confiar nela, o celular
# obviamente nao consegue abrir o HTTPS.
http://{$VAULTMARKS_SITE:vaultmarks.local} {
	handle /root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
