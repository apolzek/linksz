# TLS in front of the backend.
#
# Why this exists: on a phone the PWA only installs (and the service worker only
# registers) in a "secure context", meaning https or localhost. Reaching
# http://192.168.0.x:8787 from the phone does not work. Caddy issues a
# certificate from its own CA and solves that without a public domain.
#
# The one step: install the root CA on the phone. It lives at
# http://<SITE>/root.crt (see the http:// block below).

{
	# Issues everything with the internal CA instead of Let's Encrypt: on a
	# local network there is no public domain and no port 80 open outside.
	local_certs
	admin off
}

# VAULTMARKS_SITE = how you reach it: a hostname, or the machine's LAN IP.
{$VAULTMARKS_SITE:vaultmarks.local} {
	tls internal

	encode zstd gzip

	header {
		# Without this the browser may sniff the manifest type and ignore it.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	reverse_proxy vaultmarks:8787
}

# HTTP is only there to hand out the root CA: before trusting it, the phone
# obviously cannot open the HTTPS.
http://{$VAULTMARKS_SITE:vaultmarks.local} {
	handle /root.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
